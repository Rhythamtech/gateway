# Database
DATABASE_URL=sqlite:///./app.db

# Auth
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Providers
# JSON list. "protocol" must be either "openai" or "anthropic".
# Models are fetched automatically from {base_url}/models.
# Example:
# PROVIDERS=[{"name":"openai","protocol":"openai","base_url":"https://api.openai.com/v1","api_key":""},{"name":"claude","protocol":"anthropic","base_url":"https://api.anthropic.com/v1","api_key":""}]
PROVIDERS=[]

# Name of the provider used when a model name does not resolve to one
ROUTER_DEFAULT_PROVIDER=

# Upstream request timeout, in seconds
ROUTER_TIMEOUT=300

# Optional model aliases, e.g. {"fast":"openai/gpt-4o-mini"}. "*" acts as a wildcard route.
ROUTER_MODEL_ROUTES={}

# How long fetched model lists are cached, in seconds
ROUTER_MODEL_CACHE_TTL=300

# Provider management
# Secret used to encrypt provider API keys and custom headers at rest. Keep it
# stable: changing it makes existing stored credentials undecryptable. If left
# empty, a key is derived from JWT_SECRET_KEY for local development only.
PROVIDER_ENCRYPTION_KEY=
# Timeout for provider model synchronization, in seconds
PROVIDER_REQUEST_TIMEOUT=15
# SSRF protection. Keep false in production.
PROVIDER_ALLOW_PRIVATE_NETWORKS=false
# Redirect limit and response size limit for model synchronization
PROVIDER_MAX_REDIRECTS=3
PROVIDER_MAX_RESPONSE_BYTES=5242880

# OpenTelemetry (operational observability — spans only, never prompts)
# Master switch for request and LLM-call spans. Each user can additionally
# opt their own /v1 traffic out of spans (default) via
# PATCH /users/me/preferences; see docs/tracing.md.
TELEMETRY_ENABLED=false
# OTLP/HTTP collector endpoint that receives the spans, e.g.
# http://localhost:4318/v1/traces. Left empty, spans stay local and are not
# exported anywhere.
OTLP_EXPORTER_ENDPOINT=
# Service name attached to every span
OTEL_SERVICE_NAME=llm-gateway
# Sampler: always_on or always_off
OTEL_SAMPLER=always_on

CREDITS_DEFAULT_OUTPUT_TOKENS=2048
CREDITS_RECONCILE_INTERVAL_SECONDS=30
CREDITS_REVIEW_AFTER_SECONDS=900
