---
import "@/styles/public-pages.css"
import { BrandMark } from "@/components/brand"
import { APP_NAME } from "@/lib/site"

const groups = [
  {
    title: "Product",
    links: [
      { href: "/dashboard", label: "Dashboard" },
      { href: "/dashboard/playground", label: "Playground" },
      { href: "/dashboard/providers", label: "Providers" },
      { href: "/dashboard/model-groups", label: "Model groups" },
    ],
  },
  {
    title: "Workspace",
    links: [
      { href: "/dashboard/api-keys", label: "API keys" },
      { href: "/dashboard/credits", label: "Credits" },
      { href: "/dashboard/traces", label: "Request traces" },
      { href: "/dashboard/settings", label: "Settings" },
    ],
  },
  {
    title: "Resources",
    links: [
      { href: "/docs", label: "Docs" },
      { href: "/about", label: "About" },
      { href: "/support", label: "Support" },
      { href: "/login", label: "Sign in" },
    ],
  },
]
---

<footer class="border-t bg-background text-foreground border-border">
  <div class="public-width grid gap-8 py-8">
    <div class="grid grid-cols-2 gap-x-6 gap-y-7 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <a href="/" class="inline-flex items-center gap-2 font-semibold">
          <BrandMark alt="" className="size-7" />
          {APP_NAME}
        </a>
      </div>
      {groups.map(({ title, links }) => (
        <nav aria-label={title}>
          <h2 class="text-sm font-semibold">{title}</h2>
          <ul class="mt-3 grid gap-2 text-sm text-muted-foreground">
            {links.map(({ href, label }) => (
              <li>
                <a href={href} class="underline-offset-4 hover:underline">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border pt-4 text-sm text-muted-foreground">
      <span>
        © {new Date().getFullYear()} {APP_NAME}
      </span>
      <nav aria-label="Legal" class="flex flex-wrap gap-x-5 gap-y-2">
        <a href="/privacy" class="underline-offset-4 hover:underline">
          Privacy policy
        </a>
        <a href="/terms" class="underline-offset-4 hover:underline">
          Terms of service
        </a>
      </nav>
    </div>
  </div>
</footer>
