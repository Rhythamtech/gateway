---
import Layout from "@/layouts/main.astro"
import OfflineFooter from "@/components/offline-footer.astro"
import { DocsView } from "@/components/docs/docs-view"
import { APP_NAME } from "@/lib/site"

const apiBaseUrl = (
  import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000"
).replace(/\/$/, "")
---

<Layout title={`Developer Documentation — ${APP_NAME}`}>
  <DocsView client:load apiBaseUrl={apiBaseUrl} />
  <OfflineFooter />
</Layout>
