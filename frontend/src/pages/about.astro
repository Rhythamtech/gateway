---
import "@/styles/public-pages.css"
import Layout from "@/layouts/main.astro"
import PublicHeader from "@/components/public-header.astro"
import OfflineFooter from "@/components/offline-footer.astro"
import { buttonVariants } from "@/components/ui/button"

const responsibilities = [
  {
    title: "Model routing",
    text: "Send requests to a provider model directly, or give several models one public ID. A model group can route by priority, round robin, or weight.",
  },
  {
    title: "Usage accounting",
    text: "Gateway reserves credits before dispatch and settles charges using the provider model’s configured rate. Review charges and balance changes in Credits.",
  },
  {
    title: "Request visibility",
    text: "With tracing enabled for your account, review each provider attempt, its latency, and the token usage the provider reported.",
  },
]
---

<Layout title="About Gateway">
  <PublicHeader current="about" />

  <main class="bg-background text-foreground">
    <section class="public-width grid items-center gap-10 py-12 lg:grid-cols-2 lg:gap-16 lg:py-20">
      <div>
        <h1 class="public-title font-semibold">About Gateway</h1>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-muted-foreground">
          Gateway sits between your application and its language model
          providers. Your application uses the same Gateway endpoint when you
          change providers.
        </p>
        <a
          href="/docs"
          class={buttonVariants({ size: "lg", className: "mt-8" })}
        >
          Read the docs
        </a>
      </div>

      <figure class="rounded-xl border border-border bg-muted p-6 text-foreground sm:p-8">
        <figcaption class="font-semibold">Request path</figcaption>
        <ol class="mt-5 grid gap-3 border-l border-primary/50 pl-4">
          <li class="border-b border-border pb-3">Your application</li>
          <li class="border-b border-border pb-3">
            Gateway
            <span class="mt-1 block text-sm text-muted-foreground">
              API key, routing, and credit checks
            </span>
          </li>
          <li>Selected provider model</li>
        </ol>
      </figure>
    </section>

    <section class="border-y border-border bg-muted">
      <div class="public-width grid gap-6 py-10 lg:grid-cols-2 lg:gap-16">
        <h2 class="text-3xl font-semibold tracking-tight">
          What Gateway manages
        </h2>
        <div class="divide-y divide-border">
          {responsibilities.map(({ title, text }) => (
            <div class="py-4 first:pt-0">
              <h3 class="font-semibold">{title}</h3>
              <p class="mt-1 max-w-lg text-sm leading-relaxed text-muted-foreground">
                {text}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <OfflineFooter />
</Layout>
