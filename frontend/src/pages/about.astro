---
import Layout from "@/layouts/main.astro"
import PublicHeader from "@/components/public-header.astro"
import OfflineFooter from "@/components/offline-footer.astro"
import { Badge } from "@/components/ui/badge"
import { buttonVariants } from "@/components/ui/button"
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { APP_NAME } from "@/lib/site"
import {
  ArrowRight,
  CheckCircle2,
  Code2,
  Layers,
  Lock,
  Route,
  ShieldCheck,
  Terminal,
  Zap,
} from "lucide-react"

const clientPillars = [
  {
    icon: Route,
    title: "Universal Model Routing",
    description:
      "A unified API contract compatible with standard OpenAI and Anthropic SDKs. Switch between Gemini, Claude, Llama, and Mistral by changing a single string in your application.",
  },
  {
    icon: Lock,
    title: "Zero Data Retention (ZDR)",
    description:
      "Your prompt inputs and completions stream directly in-flight. Prompts are never stored, logged, or used to train any model unless you explicitly enable private observability traces.",
  },
  {
    icon: Layers,
    title: "High-Availability Failover",
    description:
      "Group models together into resilient routing clusters. When an upstream provider experiences rate limits, latency spikes, or outages, Gateway transparently retries with healthy alternate providers.",
  },
  {
    icon: Zap,
    title: "Exact-Cost Token Billing",
    description:
      "Transparent microcredit accounting with atomic reservation safeguards. Pay exact upstream model rates with zero arbitrary markups. Monitor spending down to the fractional microcredit.",
  },
  {
    icon: Terminal,
    title: "Interactive Web Playground",
    description:
      "Test prompts, system instructions, and sampling parameters across multiple models side-by-side in real-time right from your dashboard before deploying keys to production.",
  },
  {
    icon: Code2,
    title: "SDK Drop-In Compatibility",
    description:
      "Compatible with official OpenAI and Anthropic SDKs out of the box. Simply point your baseURL to Gateway to gain routing, failover, and analytics without rewriting client code.",
  },
]

const clientGuarantees = [
  {
    title: "Developer Sovereignty",
    desc: "You own your API keys, your model configurations, and your traffic routing. No locked-in proprietary protocols.",
  },
  {
    title: "Zero Prompt Training",
    desc: "We will never sell, store, license, or allow third parties to train models on customer prompts or completions.",
  },
  {
    title: "High-Speed Streaming Proxy",
    desc: "Direct Server-Sent Events chunk forwarding ensures sub-millisecond proxy overhead and minimal TTFT.",
  },
  {
    title: "Transparent Accounting",
    desc: "Real-time microcredit calculations based on actual upstream token consumption with zero hidden fees.",
  },
]
---

<Layout title={`About Us — ${APP_NAME}`}>
  <PublicHeader current="about" />

  <main class="min-h-screen bg-background text-foreground">
    {/* 1. Minimal Hero Section */}
    <section class="px-4 pt-12 pb-16 sm:px-6 sm:pt-20 sm:pb-20 text-center">
      <div class="mx-auto max-w-4xl">
        <div class="flex justify-center">
          <Badge
            variant="outline"
            className="gap-2 rounded-full border-border/80 bg-muted/40 px-3.5 py-1 text-xs font-normal text-muted-foreground"
          >
            <ShieldCheck className="size-3.5 text-primary" />
            Built for Developers & Engineering Teams
          </Badge>
        </div>

        <h1 class="mt-6 text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl text-foreground">
          One Interface to the World&apos;s Best AI Models.
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-base text-muted-foreground sm:text-lg leading-relaxed">
          {APP_NAME} is an open, high-performance LLM gateway and routing proxy.
          We empower developers to build resilient AI applications without
          vendor lock-in, hidden fees, or fragmented SDK codebases.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/dashboard"
            class={buttonVariants({
              variant: "default",
              size: "lg",
              className: "rounded-full px-6 font-semibold shadow-xs",
            })}
          >
            Open Dashboard
            <ArrowRight className="size-4" />
          </a>
        </div>
      </div>
    </section>

    {/* 2. Mission & Philosophy */}
    <section class="border-y border-border/40 bg-muted/15 py-16 sm:py-20">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="grid gap-10 md:grid-cols-2 md:items-center">
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-wider text-primary">
              Our Mission
            </h2>
            <p class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl text-foreground">
              Eliminating the Friction of Multi-Provider AI Infrastructure
            </p>
            <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
              Modern AI applications require multi-model versatility: fast
              reasoning models for agents, specialized coding models, and
              cost-effective embedding engines. However, juggling separate SDKs,
              inconsistent rate limits, fragmented billing dashboards, and
              unpredictable outages burdens development teams.
            </p>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
              Gateway unifies your AI traffic behind a single, resilient data
              plane. By providing automated fallbacks across model groups,
              granular budget enforcement, and deep request tracing, we ensure
              your services stay fast, reliable, and cost-effective.
            </p>
          </div>

          <Card className="rounded-xl border border-border/70 bg-card p-6 shadow-xs">
            <CardHeader className="p-0 pb-4">
              <CardTitle className="text-base font-semibold text-foreground">
                The Client Guarantee
              </CardTitle>
              <CardDescription className="text-xs text-muted-foreground">
                Core commitments every developer and application receives.
              </CardDescription>
            </CardHeader>
            <CardContent className="p-0">
              <ul class="space-y-3.5 text-xs text-muted-foreground">
                {clientGuarantees.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <CheckCircle2 className="size-4 text-emerald-500 shrink-0 mt-0.5" />
                    <span>
                      <strong class="text-foreground font-medium">
                        {item.title}:
                      </strong>{" "}
                      {item.desc}
                    </span>
                  </li>
                ))}
              </ul>
            </CardContent>
          </Card>
        </div>
      </div>
    </section>

    {/* 3. Platform Pillars (Client Features Grid) */}
    <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-primary">
            Architecture & Features
          </h2>
          <p class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl text-foreground">
            Engineered for High-Scale Production AI Workloads
          </p>
          <p class="mt-3 text-sm text-muted-foreground">
            Everything you need to deploy, test, and monitor your AI models with
            complete reliability.
          </p>
        </div>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {clientPillars.map((item) => {
            const Icon = item.icon
            return (
              <Card className="rounded-xl border border-border/70 bg-card shadow-xs transition-colors hover:border-primary/40">
                <CardHeader className="p-5 pb-3">
                  <div class="flex size-9 items-center justify-center rounded-lg bg-muted/60 text-foreground">
                    <Icon className="size-4 text-primary" />
                  </div>
                  <CardTitle className="text-base font-semibold mt-3">
                    {item.title}
                  </CardTitle>
                </CardHeader>
                <CardContent className="p-5 pt-0">
                  <CardDescription className="text-xs leading-relaxed text-muted-foreground">
                    {item.description}
                  </CardDescription>
                </CardContent>
              </Card>
            )
          })}
        </div>
      </div>
    </section>

    {/* 4. Bottom CTA */}
    <section class="border-t border-border/40 bg-muted/10 py-16 sm:py-20 text-center">
      <div class="mx-auto max-w-2xl px-4 sm:px-6">
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl text-foreground">
          Ready to streamline your model pipeline?
        </h2>
        <p class="mt-3 text-sm text-muted-foreground">
          Sign up today to test model prompts in the Playground or deploy
          unified gateway API keys.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/signup"
            class={buttonVariants({
              variant: "default",
              size: "lg",
              className: "rounded-full px-6 font-semibold shadow-xs",
            })}
          >
            Create Free Account
            <ArrowRight className="size-4" />
          </a>
          <a
            href="/support"
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              className: "rounded-full px-6 font-medium",
            })}
          >
            Contact Support
          </a>
        </div>
      </div>
    </section>
  </main>

  <OfflineFooter />
</Layout>
