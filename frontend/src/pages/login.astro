---
import Layout from "@/layouts/main.astro"
import { LoginForm } from "@/components/login-form"
import { ThemeToggle } from "@/components/theme-toggle"
---

<Layout title="Sign in — Gateway">
  <main class="relative flex min-h-svh flex-col items-center justify-center bg-background p-6 pt-16">
    <ThemeToggle client:load className="absolute top-4 right-4 z-10" />
    <div class="w-full max-w-sm">
      <LoginForm client:load />
    </div>
  </main>
</Layout>
