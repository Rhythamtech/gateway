---
import Layout from "@/layouts/main.astro"
import PublicHeader from "@/components/public-header.astro"
import OfflineFooter from "@/components/offline-footer.astro"
import { SupportPortalAction } from "@/components/support-portal-action"
import { APP_NAME } from "@/lib/site"

const apiBaseUrl = (
  import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000"
).replace(/\/$/, "")

const faqs = [
  {
    category: "Billing & Credits",
    items: [
      {
        q: "How are token charges calculated?",
        a: "Charges are calculated using versioned provider token rates for input tokens, prompt cache reads, and completion tokens. Charges are settled down to exact microcredits ($1.00 USD = 1,000,000 microcredits) using standard half-even banker's rounding.",
      },
      {
        q: "What is an atomic hold reservation?",
        a: "Before an inference request streams to an upstream model, Gateway reserves an atomic hold against your balance based on the model's max token ceiling. Once the request finishes, the actual tokens consumed are deducted and all unspent reservation funds are released immediately.",
      },
      {
        q: "How do I redeem credit coupons?",
        a: "In Dashboard > Credits, enter your coupon code under Redeem a coupon and select Redeem credits.",
      },
    ],
  },
  {
    category: "Integration & SDKs",
    items: [
      {
        q: "Can I use standard OpenAI SDK with Gateway?",
        a: `Yes! Set your OpenAI client's baseURL to "${apiBaseUrl}/v1" and pass your Gateway API key in the authorization header. All standard endpoints (/v1/chat/completions, /v1/models) conform to OpenAI SDK wire contracts.`,
      },
      {
        q: "Can I use Anthropic SDK with Gateway?",
        a: `Yes! Our endpoint at "${apiBaseUrl}/v1/messages" accepts the official Anthropic messages schema and returns streaming SSE events matching Anthropic protocol specifications.`,
      },
      {
        q: "What are the API rate limits?",
        a: "Standard API keys have an automatic sliding window rate limit of 60 requests per minute per key to ensure fair infrastructure distribution.",
      },
    ],
  },
  {
    category: "Model Groups & Reliability",
    items: [
      {
        q: "How does automatic failover work?",
        a: "Model Groups bundle multiple upstream models or providers together under one virtual alias. Gateway dispatches requests to primary models first; if an upstream provider reports a 5xx error or rate limit, Gateway automatically retries with secondary fallbacks in your group.",
      },
      {
        q: "Where do I find my request traces?",
        a: "If you have Request Tracing enabled in your dashboard settings, all calls are recorded under Dashboard > Request Traces, detailing millisecond latency, token usage, and payload history.",
      },
    ],
  },
]
---

<Layout title={`Support & Help Center — ${APP_NAME}`}>
  <PublicHeader current="support" />

  <main class="min-h-screen bg-background text-foreground py-12 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      {/* Hero */}
      <div class="text-center pb-12 border-b border-border/60">
        <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl">
          Support
        </h1>
      </div>

      {/* Ticket Raising Portal Action */}
      <div class="mt-12">
        <SupportPortalAction client:load />
      </div>

      {/* Quick Documentation Resources Grid */}
      <div class="mt-16">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-primary text-center">
          Developer Resources
        </h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <a
            href={`${apiBaseUrl}/openapi.json`}
            target="_blank"
            class="rounded-xl border border-border/80 bg-card p-5 shadow-xs transition-all hover:border-primary/50 hover:shadow-sm"
          >
            <h3 class="text-sm font-semibold text-foreground">
              OpenAPI Specification
            </h3>
            <p class="mt-1 text-xs text-muted-foreground">
              Raw OpenAPI v3 JSON spec for automated SDK generation and contract
              verification.
            </p>
          </a>
          <a
            href="/dashboard/playground"
            class="rounded-xl border border-border/80 bg-card p-5 shadow-xs transition-all hover:border-primary/50 hover:shadow-sm"
          >
            <h3 class="text-sm font-semibold text-foreground">
              Interactive Playground
            </h3>
            <p class="mt-1 text-xs text-muted-foreground">
              Test prompt generations, inspect token streaming, and verify model
              parameters in real time.
            </p>
          </a>
        </div>
      </div>

      {/* FAQs Section */}
      <div class="mt-16 border-t border-border/60 pt-16">
        <div class="text-center">
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
            Frequently asked questions
          </h2>
        </div>

        <div class="mt-10 space-y-10">
          {faqs.map((cat) => (
            <div>
              <h3 class="text-base font-bold text-foreground border-b pb-2 mb-4">
                {cat.category}
              </h3>
              <div class="grid gap-4 sm:grid-cols-2">
                {cat.items.map((item) => (
                  <div class="rounded-xl border border-border/60 bg-muted/20 p-5 shadow-xs">
                    <h4 class="text-xs font-semibold text-foreground">
                      {item.q}
                    </h4>
                    <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                      {item.a}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>

  <OfflineFooter />
</Layout>
