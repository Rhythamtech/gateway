---
import "@/styles/public-pages.css"
import Layout from "@/layouts/main.astro"
import PublicHeader from "@/components/public-header.astro"
import OfflineFooter from "@/components/offline-footer.astro"
import { SupportPortalAction } from "@/components/support-portal-action"
import { APP_NAME } from "@/lib/site"

const apiBaseUrl = (
  import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000"
).replace(/\/$/, "")

const faqs = [
  {
    category: "Billing and credits",
    items: [
      {
        q: "How are token charges calculated?",
        a: "Gateway uses the configured rates for input, output, and cache tokens. It rounds the final charge to six decimal places using half-even rounding.",
      },
      {
        q: "Why are some credits reserved?",
        a: "Gateway holds credits before sending your request. After settlement, unused credits return to your available balance. If usage is missing, the hold may need review.",
      },
      {
        q: "How do I redeem credit coupons?",
        a: "In Dashboard > Credits, enter your coupon code under Redeem a coupon and select Redeem credits.",
      },
    ],
  },
  {
    category: "SDKs and API access",
    items: [
      {
        q: "Can I use the OpenAI SDK?",
        a: `Set your OpenAI client’s base URL to "${apiBaseUrl}/v1" and use your Gateway API key.`,
      },
      {
        q: "Can I use the Anthropic SDK?",
        a: `Set your Anthropic client’s base URL to "${apiBaseUrl}" and use your Gateway API key. The SDK sends requests to /v1/messages.`,
      },
      {
        q: "What are the API rate limits?",
        a: "Gateway allows up to 60 inference requests per minute per API key.",
      },
    ],
  },
  {
    category: "Routing and traces",
    items: [
      {
        q: "How does automatic failover work?",
        a: "A model group gives several provider models one public ID. If an attempt fails with a retryable error, Gateway can try another eligible model in the group.",
      },
      {
        q: "Where do I find my request traces?",
        a: "Open Request traces in the dashboard. When tracing is enabled for your account, you can inspect recorded requests and their provider attempts.",
      },
    ],
  },
]
---

<Layout title={`Support | ${APP_NAME}`}>
  <PublicHeader current="support" />

  <main class="bg-background text-foreground">
    <div class="public-width grid gap-10 py-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16 lg:py-20">
      <div>
        <h1 class="public-title font-semibold">Support</h1>
        <div class="mt-8">
          <SupportPortalAction client:load />
        </div>
        <nav
          aria-label="Developer resources"
          class="mt-8 flex flex-wrap gap-x-5 gap-y-3 text-sm font-medium text-primary"
        >
          <a href="/docs" class="underline underline-offset-4">
            Docs
          </a>
          <a
            href={`${apiBaseUrl}/openapi.json`}
            class="underline underline-offset-4"
          >
            OpenAPI JSON
          </a>
          <a href="/dashboard/playground" class="underline underline-offset-4">
            Playground
          </a>
        </nav>
      </div>

      <section aria-labelledby="support-questions">
        <h2
          id="support-questions"
          class="text-2xl font-semibold tracking-tight"
        >
          Frequently asked questions
        </h2>
        <div class="mt-6 grid gap-7">
          {faqs.map(({ category, items }) => (
            <div>
              <h3 class="mb-2 text-sm font-semibold text-primary">
                {category}
              </h3>
              <div class="border-b border-border">
                {items.map(({ q, a }) => (
                  <details class="border-t border-border py-3">
                    <summary class="cursor-pointer py-1 font-medium">
                      {q}
                    </summary>
                    <p class="py-2 pl-4 text-sm leading-relaxed break-words text-muted-foreground">
                      {a}
                    </p>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <OfflineFooter />
</Layout>
