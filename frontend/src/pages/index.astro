---
import Layout from "@/layouts/main.astro"
import { BrandMark } from "@/components/brand"
import { APP_NAME, APP_TAGLINE } from "@/lib/site"
---

<Layout>
  <div
    class="flex min-h-svh flex-col items-center justify-center gap-6 p-6 text-center"
  >
    <BrandMark className="size-28" alt="" />
    <div class="flex flex-col gap-2">
      <h1 class="text-2xl font-semibold">{APP_NAME}</h1>
      <p class="text-sm text-muted-foreground">{APP_TAGLINE}</p>
    </div>
    <div class="flex items-center gap-3 text-sm font-medium">
      <a
        href="/login"
        class="rounded-md bg-primary px-4 py-2 text-primary-foreground transition-colors hover:bg-primary/90"
      >
        Sign in
      </a>
      <a
        href="/signup"
        class="rounded-md border px-4 py-2 transition-colors hover:bg-accent"
      >
        Create account
      </a>
    </div>
  </div>
</Layout>
