---
import "@/styles/public-pages.css"
import Layout from "@/layouts/main.astro"
import PublicHeader from "@/components/public-header.astro"
import OfflineFooter from "@/components/offline-footer.astro"
import { LandingHeroActions } from "@/components/landing-hero-actions"
import { LandingCodePreview } from "@/components/landing-code-preview"
import { APP_NAME } from "@/lib/site"

const capabilities = [
  {
    title: "Routing and failover",
    description:
      "Give a group of provider models one public ID. Set their priority or traffic weights, and Gateway can try another eligible model when a provider fails.",
  },
  {
    title: "Usage credits",
    description:
      "Gateway reserves credits before sending a request and settles the charge from reported token usage at the provider model’s configured rate.",
  },
  {
    title: "Request tracing",
    description:
      "When tracing is enabled for your account, inspect request details, provider attempts, and latency in the dashboard.",
  },
]

const steps = [
  "Create an API key in the dashboard.",
  "Set your SDK’s base URL to Gateway.",
  "Send a request with a configured model ID.",
]
---

<Layout title={`${APP_NAME} | LLM gateway`}>
  <PublicHeader current="home" />

  <main class="bg-background text-foreground">
    <section
      aria-labelledby="landing-title"
      class="public-width grid items-center gap-10 py-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-12 lg:py-20"
    >
      <div class="min-w-0">
        <h1 id="landing-title" class="public-title font-semibold">
          Route LLM requests across providers
        </h1>
        <p class="landing-muted mt-6 max-w-sm text-base leading-relaxed sm:text-lg">
          Connect your OpenAI or Anthropic SDK to Gateway and choose a provider
          model or a model group in each request.
        </p>
        <div class="mt-8">
          <LandingHeroActions client:load />
        </div>
      </div>

      <div class="min-w-0">
        <LandingCodePreview client:load />
      </div>
    </section>

    <section aria-labelledby="quickstart" class="quickstart">
      <div class="public-width grid gap-6 py-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-12">
        <div>
          <h2 id="quickstart" class="text-2xl font-semibold tracking-tight">
            Get started
          </h2>
          <a
            href="/docs#quickstart"
            class="landing-link mt-2 inline-block text-sm font-medium"
          >
            Read the quickstart
          </a>
        </div>
        <ol class="step-list grid gap-4 text-sm sm:grid-cols-3">
          {steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </div>
    </section>

    <section aria-labelledby="capabilities" class="public-width py-12 sm:py-16">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-12">
        <h2 id="capabilities" class="text-3xl font-semibold tracking-tight">
          How Gateway works
        </h2>
        <div>
          {capabilities.map(({ title, description }) => (
            <div class="capability grid gap-2 border-t py-5 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.65fr)] sm:gap-5">
              <h3 class="text-base font-semibold">{title}</h3>
              <p class="landing-muted text-sm leading-relaxed">{description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <OfflineFooter />
</Layout>

<style>
  .landing-muted {
    color: var(--muted-foreground);
  }

  .quickstart {
    background: var(--muted);
    border-block: 1px solid var(--border);
  }

  .landing-link {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .step-list {
    counter-reset: quickstart;
  }

  .step-list li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    align-content: start;
    gap: 0.5rem;
    counter-increment: quickstart;
  }

  .step-list li::before {
    content: counter(quickstart) ".";
    color: var(--primary);
    font-weight: 600;
  }

  .capability {
    border-color: var(--border);
  }
</style>
