---
import "@/styles/global.css"
import { APP_DESCRIPTION, APP_NAME, APP_TAGLINE } from "@/lib/site"
import { ClientRouter } from "astro:transitions"
import { Toaster } from "@/components/ui/sonner"

interface Props {
  title?: string
}
const { title = `${APP_NAME} — ${APP_TAGLINE}` } = Astro.props
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      ;(() => {
        const apply = () => {
          try {
            const stored = localStorage.getItem("gateway-theme")
            const fallback = /^\/dashboard(?:\/|$)/.test(location.pathname)
              ? "dark"
              : "system"
            const theme =
              stored === "light" || stored === "dark" || stored === "system"
                ? stored
                : fallback
            const isDark =
              theme === "dark" ||
              (theme === "system" &&
                window.matchMedia("(prefers-color-scheme: dark)").matches)
            const root = document.documentElement
            root.classList.toggle("dark", isDark)
            root.style.colorScheme = isDark ? "dark" : "light"
            root.dataset.theme = theme
            // Absence of the attribute means the default "classic" style; only
            // allowlist values are written so a stale key stays harmless.
            // Keep the keys in sync with THEME_STYLES / DARK_CANVAS_META in
            // lib/theme.ts.
            const darkCanvas = {
              classic: "#0a0a0a",
              "endless-blue": "#0a0b0d",
              "fresh-green": "#001e2b",
              ember: "#000000",
              devlog: "#0f172a",
            }
            const style = localStorage.getItem("gateway-theme-style")
            if (style !== null && style in darkCanvas)
              root.dataset.themeStyle = style
            document
              .querySelectorAll('meta[name="theme-color"]')
              ?.forEach((meta) =>
                meta.setAttribute(
                  "content",
                  style === "devlog"
                    ? "#0f172a"
                    : isDark
                      ? (darkCanvas[style] ?? "#0a0a0a")
                      : "#ffffff"
                )
              )
          } catch {
            // Ignore unavailable storage; the default light theme still applies.
          }
        }
        apply()
        // Astro's client router swaps in the server-rendered <html>, which
        // has no dark class; re-apply the stored theme right after every
        // swap so client-side navigation keeps the saved light/dark/system
        // choice (this runs before the next paint, so there is no flash).
        document.addEventListener("astro:after-swap", apply)
      })()
    </script>
    <meta name="description" content={APP_DESCRIPTION} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/brand/favicon-32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/brand/favicon-192.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/brand/apple-touch-icon.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <!-- Swap pages client-side instead of full document reloads. The swap is
         instant: the root crossfade is disabled via transition:animate="none". -->
    <ClientRouter />
  </head>
  <body>
    <slot />
    <!-- Side pop notifications (sonner) mounted once globally; persisted
         across client-side page swaps so stacked toasts survive navigation. -->
    <Toaster client:only="react" transition:persist="gateway-toaster" />
  </body>
</html>
