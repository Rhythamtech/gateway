---
import "@/styles/global.css"
import { APP_DESCRIPTION, APP_NAME, APP_TAGLINE } from "@/lib/site"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      ;(() => {
        try {
          const stored = localStorage.getItem("gateway-theme")
          const theme =
            stored === "light" || stored === "dark" || stored === "system"
              ? stored
              : "system"
          const isDark =
            theme === "dark" ||
            (theme === "system" &&
              window.matchMedia("(prefers-color-scheme: dark)").matches)
          const root = document.documentElement
          root.classList.toggle("dark", isDark)
          root.style.colorScheme = isDark ? "dark" : "light"
          root.dataset.theme = theme
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", isDark ? "#0a0a0a" : "#ffffff")
        } catch {
          // Ignore unavailable storage; the default light theme still applies.
        }
      })()
    </script>
    <meta name="description" content={APP_DESCRIPTION} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/brand/favicon-32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/brand/favicon-192.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/brand/apple-touch-icon.png"
    />
    <title>{APP_NAME} — {APP_TAGLINE}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
