---
import "@/styles/public-pages.css"
import Layout from "@/layouts/main.astro"
import OfflineFooter from "@/components/offline-footer.astro"
import { BrandMark } from "@/components/brand"
import { ThemeToggle } from "@/components/theme-toggle"

interface Props {
  title: string
}

const { title } = Astro.props
---

<Layout title={title}>
  <div class="flex min-h-svh flex-col bg-background text-foreground">
    <header class="border-b border-border">
      <div class="public-width flex min-h-16 items-center justify-between gap-4">
        <a href="/" class="inline-flex items-center gap-2 font-semibold">
          <BrandMark alt="" className="size-7" />
          Gateway
        </a>
        <ThemeToggle client:load />
      </div>
    </header>

    <main class="public-width flex flex-1 items-center justify-center py-10 sm:py-16">
      <div class="w-full max-w-md rounded-xl border border-border bg-muted p-5 sm:p-9">
        <slot />
      </div>
    </main>
    <OfflineFooter />
  </div>
</Layout>
